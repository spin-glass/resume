# Ignore all .deb files
*.deb

# Ignore other files or directories as needed
.next
node_modules
.vercel
.env.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
dist/
*.egg-info/
.env
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/

# Web package (packages/web/)
packages/web/.next/
packages/web/node_modules/

# Resume review agents (packages/resume-review/)
packages/resume-review/.venv/
packages/resume-review/dist/
packages/resume-review/*.egg-info/
packages/resume-review/.env
packages/resume-review/*.log
packages/resume-review/.langgraph_api/
packages/resume-review/workflow.png
packages/resume-review/workflow_graph.png

# Resume output (keep directory, ignore generated files)
resume/output/*.pdf
resume/output/*.html
!resume/output/.gitkeep

# Temporary files
/tmp/resume-screenshots/
~/.resume-review/

# Design auto-fix feature (013-design-auto-fix)
backups/                    # File backups (CSS, QMD)
review_sessions/            # Preview screenshots and temp files
review_*/                   # Review session directories
resume/jobs/                # Real job descriptions (private)
# Gap analysis output in jobs folder (Legacy)
resume/jobs/gap_analysis_*/
# Legacy gap analysis folders
gap_analysis_*/
# Gap analysis output folders
resume/gap_analysis_*
