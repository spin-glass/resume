# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Google Gemini API Configuration (optional, for multi-provider support)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Configuration (optional, for multi-provider support)
OPENAI_API_KEY=your_openai_api_key_here

# Output Directory (optional)
# RESUME_REVIEW_OUTPUT_DIR=.

# Default LLM Provider (optional, defaults to 'anthropic')
# Options: anthropic, google, openai
# LLM_PROVIDER=anthropic

# Default Model (optional, provider-specific defaults will be used if not set)
# For Anthropic: claude-opus-4-5-20251101, claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
# For Google: gemini-2.0-flash-exp, gemini-1.5-pro
# For OpenAI: gpt-4o, gpt-4-turbo
# DEFAULT_MODEL=claude-opus-4-5-20251101
