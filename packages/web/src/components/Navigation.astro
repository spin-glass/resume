---
---
<header class="bg-(--color-primary) text-white shadow-md no-print">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
    <!-- Logo / Home Link -->
    <a href={import.meta.env.BASE_URL} class="font-bold text-xl tracking-tight hover:text-(--color-accent) transition-colors flex items-center gap-2">
      <span class="text-2xl">⚡</span>
      <span>Resume</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-6 items-center">
      <a href={import.meta.env.BASE_URL} class="hover:text-(--color-accent) transition-colors font-medium">Home</a>
      <a href={`${import.meta.env.BASE_URL}career`} class="hover:text-(--color-accent) transition-colors font-medium">Career</a>
      <!-- Portfolio Stub -->
      <!-- <a href={`${import.meta.env.BASE_URL}portfolio`} class="hover:text-(--color-accent) transition-colors font-medium opacity-50 cursor-not-allowed" title="Coming Soon">Portfolio</a> -->
      <a href="https://github.com/toshi-toma/resume" target="_blank" rel="noopener noreferrer" class="hover:text-(--color-accent) transition-colors font-medium flex items-center gap-1">
        GitHub
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
      </a>
    </nav>

    <!-- Mobile Menu Button (Simple) -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-white hover:bg-(--color-secondary) rounded-md" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden bg-(--color-primary) border-t border-(--color-secondary)">
    <nav class="flex flex-col p-4 space-y-4">
      <a href={import.meta.env.BASE_URL} class="block hover:bg-(--color-secondary) px-4 py-2 rounded transition-colors">Home</a>
      <a href={`${import.meta.env.BASE_URL}career`} class="block hover:bg-(--color-secondary) px-4 py-2 rounded transition-colors">Career</a>
      <a href="https://github.com/toshi-toma/resume" target="_blank" rel="noopener noreferrer" class="block hover:bg-(--color-secondary) px-4 py-2 rounded transition-colors">GitHub</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
