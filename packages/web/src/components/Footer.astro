---
const today = new Date();
---
<footer class="bg-slate-100 text-slate-600 mt-auto py-8 no-print border-t border-slate-200">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8 text-center text-sm">
    <p>&copy; {today.getFullYear()} Toshiyuki Toma. All rights reserved.</p>
    <div class="flex justify-center gap-4 mt-4">
      <a href="https://github.com/toshi-toma" target="_blank" class="hover:text-(--color-primary) transition-colors">GitHub</a>
      <a href="https://linkedin.com/in/toshi-toma" target="_blank" class="hover:text-(--color-primary) transition-colors">LinkedIn</a>
    </div>
  </div>
</footer>
