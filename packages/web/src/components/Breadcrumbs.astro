---
const { pathname } = Astro.url;
// Normalize base URL to ensure trailing slash for replacement
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const currentPath = pathname.replace(baseUrl, '/'); // Strip base path to get relative path
const paths = currentPath.split('/').filter(Boolean);

const breadcrumbs = [
  { label: 'Home', href: baseUrl },
  ...paths.map((path, index) => {
    // Construct href relative to base
    const href = `${baseUrl}${paths.slice(0, index + 1).join('/')}`;
    // Capitalize and replace hyphens
    const label = path.charAt(0).toUpperCase() + path.slice(1).replace(/-/g, ' ');
    return { label, href };
  })
];

// Don't show on home page if only home
if (breadcrumbs.length <= 1) {
  return;
}
---

<nav aria-label="Breadcrumb" class="max-w-screen-xl mx-auto px-4 md:px-8 py-4 text-sm text-slate-500 no-print">
  <ol class="flex items-center gap-2">
    {breadcrumbs.map((breadcrumb, index) => (
      <li class="flex items-center">
        {index > 0 && <span class="mx-2 text-slate-400">/</span>}
        {index === breadcrumbs.length - 1 ? (
          <span class="font-medium text-slate-800" aria-current="page">{breadcrumb.label}</span>
        ) : (
          <a href={breadcrumb.href} class="hover:text-(--color-primary) transition-colors">{breadcrumb.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
