---
import Layout from '../../layouts/Layout.astro';

// Ensure base path always ends with a slash for consistent joining, or handled carefully
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portfolioBase = `${base}/portfolio`;
---

<Layout title="Portfolios | Architecture & Implementation">
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <!-- Hero Section -->
    <header class="mb-20 text-center">
      <h1 class="text-6xl font-black mb-6 text-slate-900 dark:text-white tracking-tight">
        Portfolio
      </h1>
      <p class="text-xl text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed">
        設計・実装・運用の全工程を網羅したプロジェクト事例
      </p>
    </header>

    <!-- Professional Portfolios Section -->
    <section class="mb-24">
      <div class="mb-12 border-b-4 border-blue-600 pb-4 inline-block">
        <h2 class="text-4xl font-extrabold text-slate-900 dark:text-white">
          Professional Portfolios
        </h2>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-10">
        <!-- Resume Project Card (The main portfolio) -->
        <a 
          href={`${portfolioBase}/resume`}
          class="group block relative bg-gradient-to-br from-white to-slate-50 dark:from-slate-800 dark:to-slate-900 rounded-3xl p-10 border border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-400 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden"
        >
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-700"></div>
          
          <div class="relative z-10">
            <div class="text-7xl mb-8">📄</div>
            <h3 class="text-3xl font-black mb-4 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Resume Project
            </h3>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 leading-relaxed">
              この職務経歴書サイト自体の設計・実装。AIエージェント統合、モノレポ設計、そしてAstroによる高速化など、開発の全工程を網羅したメインポートフォリオです。
            </p>
            
            <div class="flex flex-wrap gap-2 mb-8">
              {['LangGraph', 'Astro 5', 'pnpm Workspace', 'TypeScript'].map(tech => (
                <span class="text-xs px-3 py-1.5 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-full font-bold uppercase tracking-wider">
                  {tech}
                </span>
              ))}
            </div>
            
            <div class="flex items-center gap-3 text-blue-600 dark:text-blue-400 font-black text-lg">
              ポートフォリオを見る
              <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </div>
          </div>
        </a>

        <!-- Spec-Driven Development Card -->
        <a 
          href={`${portfolioBase}/spec-driven-development`}
          class="group block relative bg-gradient-to-br from-white to-slate-50 dark:from-slate-800 dark:to-slate-900 rounded-3xl p-10 border border-slate-200 dark:border-slate-700 hover:border-green-500 dark:hover:border-green-400 transition-all hover:shadow-2xl hover:-translate-y-2 overflow-hidden"
        >
          <div class="absolute top-0 right-0 w-32 h-32 bg-green-500/10 rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-700"></div>
          
          <div class="relative z-10">
            <div class="text-7xl mb-8">🧩</div>
            <h3 class="text-3xl font-black mb-4 text-slate-900 dark:text-white group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
              Spec-Driven Development
            </h3>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 leading-relaxed">
              AIとの協働を最大化する開発プロセス。仕様書（Spec）をSingle Source of Truthとし、手戻りのない堅牢なエージェント開発ワークフローを確立。
            </p>
            
            <div class="flex flex-wrap gap-2 mb-8">
              {['Methodology', 'Process', 'Governance'].map(tech => (
                <span class="text-xs px-3 py-1.5 bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300 rounded-full font-bold uppercase tracking-wider">
                  {tech}
                </span>
              ))}
            </div>
            
            <div class="flex items-center gap-3 text-green-600 dark:text-green-400 font-black text-lg">
              詳細を見る
              <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </div>
          </div>
        </a>

        <!-- Upcoming Portfolios (Disabled/Opacity) -->
        <div class="group block bg-slate-50 dark:bg-slate-900/40 rounded-3xl p-10 border-2 border-dashed border-slate-300 dark:border-slate-800 opacity-60">
          <div class="text-7xl mb-8 grayscale">💡</div>
          <h3 class="text-3xl font-black mb-4 text-slate-400">Coming Soon</h3>
          <p class="text-lg text-slate-400 mb-8 leading-relaxed italic">
            個人プロジェクト、OSS活動、および研究開発の成果を順次公開予定です。
          </p>
        </div>
      </div>
    </section>

    <!-- Technical Specs CTA -->
    <section class="bg-slate-900 dark:bg-white rounded-3xl p-16 text-center text-white dark:text-slate-900 shadow-2xl">
      <h2 class="text-4xl font-black mb-6">Built with Spec-First Approach</h2>
      <p class="text-xl text-slate-400 dark:text-slate-500 mb-10 max-w-2xl mx-auto">
        すべての実装は詳細な技術仕様書に基づいています。ドキュメント自体をコードとして管理する、Architecture as Codeの実践を公開しています。
      </p>
      <a 
        href="https://github.com/toshify/resume" 
        target="_blank"
        class="inline-flex items-center gap-4 px-12 py-6 bg-blue-600 text-white rounded-2xl font-black text-xl hover:bg-blue-500 transition-all hover:scale-105"
      >
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub Repository
      </a>
    </section>
  </div>
</Layout>


